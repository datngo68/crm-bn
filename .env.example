# Browser / client (public HTTPS)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-host
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: Docker-internal Kong/Envoy (skip Cloudflare hairpin).
# Self-hosted example: http://supabase-envoy:8000
# Leave empty to fall back to NEXT_PUBLIC_SUPABASE_URL
SUPABASE_INTERNAL_URL=http://supabase-envoy:8000

# Public URL of this app (for Telegram links + webhook)
NEXT_PUBLIC_APP_URL=https://crm.yourdomain.com

# Shared secret for cron + telegram webhook
CRON_SECRET=change-me-long-random
TELEGRAM_WEBHOOK_SECRET=change-me-long-random

